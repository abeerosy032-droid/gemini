<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متجر الأزياء — GLM-5.1</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://unpkg.com/pinia@2/dist/pinia.iife.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');
        
        * { font-family: 'IBM Plex Sans Arabic', sans-serif; }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #6b7280; }
        
        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 3px;
            background: #374151;
            outline: none;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #7c3aed;
            cursor: pointer;
            transition: all 0.2s;
        }
        input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
            background: #a78bfa;
        }
        
        .product-card:hover .product-image {
            transform: scale(1.08);
        }
        .product-card:hover .add-btn {
            transform: translateY(0);
            opacity: 1;
        }
        
        .cart-drawer-enter-active,
        .cart-drawer-leave-active {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .cart-drawer-enter-from,
        .cart-drawer-leave-to {
            transform: translateX(100%);
        }
        
        .modal-enter-active,
        .modal-leave-active {
            transition: all 0.3s ease;
        }
        .modal-enter-from,
        .modal-leave-to {
            opacity: 0;
        }
        .modal-enter-from .modal-content,
        .modal-leave-to .modal-content {
            transform: scale(0.95);
        }
        
        .product-list-enter-active,
        .product-list-leave-active {
            transition: all 0.4s ease;
        }
        .product-list-enter-from {
            opacity: 0;
            transform: translateY(20px);
        }
        .product-list-leave-to {
            opacity: 0;
            transform: scale(0.9);
        }
        
        .heart-btn:active {
            transform: scale(0.8);
        }
        [v-cloak] { display: none !important; }
        
        /* Hide modals by default until Vue mounts */
        .vue-modal-hidden { display: none !important; }
        
        .heart-btn.active {
            color: #ef4444;
        }
        
        @keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }
        .badge-pulse {
            animation: pulse-badge 2s infinite;
        }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
    <div id="app">
        <!-- Header -->
        <header class="sticky top-0 z-40 bg-gray-900/95 backdrop-blur-sm border-b border-gray-800">
            <div class="max-w-7xl mx-auto px-4 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-700 rounded-xl flex items-center justify-center">
                            <i class="bi bi-bag text-xl"></i>
                        </div>
                        <h1 class="text-xl font-bold bg-gradient-to-r from-purple-400 to-purple-600 bg-clip-text text-transparent">
                            متجر الأزياء
                        </h1>
                    </div>
                    
                    <div class="flex items-center gap-4">
                        <button @click="toggleWishlist" class="relative p-2 hover:bg-gray-800 rounded-lg transition-colors">
                            <i class="bi bi-heart text-xl" :class="wishlistCount > 0 ? 'text-red-500' : 'text-gray-400'"></i>
                            <span v-if="wishlistCount > 0" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full text-xs flex items-center justify-center font-bold">
                                {{ wishlistCount }}
                            </span>
                        </button>
                        
                        <button @click="cartStore.openCart" class="relative p-2 hover:bg-gray-800 rounded-lg transition-colors">
                            <i class="bi bi-cart3 text-xl text-gray-400"></i>
                            <span v-if="cartStore.totalItems > 0" class="absolute -top-1 -right-1 w-5 h-5 bg-purple-500 rounded-full text-xs flex items-center justify-center font-bold">
                                {{ cartStore.totalItems }}
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 py-8">
            <div class="flex gap-8">
                <!-- Filters Sidebar -->
                <aside class="w-72 flex-shrink-0 hidden lg:block">
                    <div class="bg-gray-800 rounded-2xl p-6 sticky top-24">
                        <h2 class="text-lg font-bold mb-6 flex items-center gap-2">
                            <i class="bi bi-funnel text-purple-400"></i>
                            الفلترة
                        </h2>
                        
                        <div class="mb-6">
                            <label class="text-sm text-gray-400 mb-3 block">نطاق السعر</label>
                            <input type="range" v-model.number="filters.maxPrice" min="0" max="500" step="10" class="mb-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400">0 ر.س</span>
                                <span class="text-purple-400 font-bold">{{ filters.maxPrice }} ر.س</span>
                            </div>
                        </div>
                        
                        <div class="mb-6">
                            <label class="text-sm text-gray-400 mb-3 block">اللون</label>
                            <div class="flex flex-wrap gap-2">
                                <button v-for="color in colors" :key="color.id"
                                    @click="toggleColor(color.id)"
                                    :class="filters.colors.includes(color.id) ? 'ring-2 ring-purple-500 ring-offset-2 ring-offset-gray-800' : ''"
                                    class="w-8 h-8 rounded-full transition-transform hover:scale-110"
                                    :style="{ backgroundColor: color.hex }"
                                    :title="color.name">
                                </button>
                            </div>
                        </div>
                        
                        <div class="mb-6">
                            <label class="text-sm text-gray-400 mb-3 block">المقاس</label>
                            <div class="flex flex-wrap gap-2">
                                <button v-for="size in sizes" :key="size"
                                    @click="toggleSize(size)"
                                    :class="filters.sizes.includes(size) ? 'bg-purple-500 text-white' : 'bg-gray-700 text-gray-300 hover:bg-gray-600'"
                                    class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
                                    {{ size }}
                                </button>
                            </div>
                        </div>
                        
                        <div class="mb-6">
                            <label class="text-sm text-gray-400 mb-3 block">التقييم</label>
                            <div class="flex gap-1">
                                <button v-for="star in 5" :key="star"
                                    @click="filters.rating = star"
                                    class="text-2xl transition-colors"
                                    :class="star <= filters.rating ? 'text-yellow-400' : 'text-gray-600'">
                                    <i class="bi bi-star-fill"></i>
                                </button>
                            </div>
                        </div>
                        
                        <button @click="resetFilters" class="w-full py-2.5 bg-gray-700 hover:bg-gray-600 rounded-lg text-sm font-medium transition-colors">
                            <i class="bi bi-arrow-counterclockwise ml-2"></i>
                            إعادة تعيين
                        </button>
                    </div>
                </aside>

                <!-- Products Grid -->
                <div class="flex-1">
                    <button @click="showMobileFilters = !showMobileFilters" class="lg:hidden mb-4 w-full py-3 bg-gray-800 rounded-xl flex items-center justify-center gap-2">
                        <i class="bi bi-funnel"></i>
                        <span>الفلترة</span>
                        <span v-if="hasActiveFilters" class="w-2 h-2 bg-purple-500 rounded-full"></span>
                    </button>
                    
                    <div v-if="showMobileFilters" class="lg:hidden mb-6 bg-gray-800 rounded-2xl p-6">
                        <div class="mb-4">
                            <label class="text-sm text-gray-400 mb-3 block">نطاق السعر</label>
                            <input type="range" v-model.number="filters.maxPrice" min="0" max="500" step="10" class="mb-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-400">0 ر.س</span>
                                <span class="text-purple-400 font-bold">{{ filters.maxPrice }} ر.س</span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="text-sm text-gray-400 mb-3 block">اللون</label>
                            <div class="flex flex-wrap gap-2">
                                <button v-for="color in colors" :key="color.id"
                                    @click="toggleColor(color.id)"
                                    :class="filters.colors.includes(color.id) ? 'ring-2 ring-purple-500' : ''"
                                    class="w-8 h-8 rounded-full"
                                    :style="{ backgroundColor: color.hex }">
                                </button>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="text-sm text-gray-400 mb-3 block">المقاس</label>
                            <div class="flex flex-wrap gap-2">
                                <button v-for="size in sizes" :key="size"
                                    @click="toggleSize(size)"
                                    :class="filters.sizes.includes(size) ? 'bg-purple-500 text-white' : 'bg-gray-700 text-gray-300'"
                                    class="px-3 py-1.5 rounded-lg text-sm">
                                    {{ size }}
                                </button>
                            </div>
                        </div>
                        <button @click="resetFilters" class="w-full py-2 bg-gray-700 rounded-lg text-sm">
                            إعادة تعيين
                        </button>
                    </div>
                    
                    <div class="flex items-center justify-between mb-6">
                        <p class="text-gray-400">
                            <span class="text-white font-bold">{{ filteredProducts.length }}</span> منتج
                        </p>
                        <select v-model="sortBy" class="bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 text-sm">
                            <option value="default">الترتيب الافتراضي</option>
                            <option value="price-asc">السعر: من الأقل</option>
                            <option value="price-desc">السعر: من الأعلى</option>
                            <option value="rating">التقييم</option>
                        </select>
                    </div>
                    
                    <TransitionGroup name="product-list" tag="div" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div v-for="product in filteredProducts" :key="product.id" class="product-card bg-gray-800 rounded-2xl overflow-hidden group">
                            <div class="relative overflow-hidden aspect-[4/5]">
                                <img :src="product.image" :alt="product.name" class="product-image w-full h-full object-cover transition-transform duration-500">
                                
                                <div class="absolute top-3 right-3 flex gap-2">
                                    <span v-if="product.isNew" class="badge-pulse bg-green-500 text-white text-xs px-2.5 py-1 rounded-full font-medium">
                                        جديد
                                    </span>
                                    <span v-if="product.discount" class="bg-red-500 text-white text-xs px-2.5 py-1 rounded-full font-medium">
                                        خصم {{ product.discount }}%
                                    </span>
                                </div>
                                
                                <button @click="openQuickView(product)" class="absolute bottom-3 left-3 w-10 h-10 bg-white/90 hover:bg-white rounded-full flex items-center justify-center transition-colors opacity-0 group-hover:opacity-100">
                                    <i class="bi bi-eye text-gray-800"></i>
                                </button>
                                
                                <button @click="toggleWishlistItem(product.id)" class="absolute top-3 left-3 w-10 h-10 bg-white/90 hover:bg-white rounded-full flex items-center justify-center transition-colors opacity-0 group-hover:opacity-100">
                                    <i class="bi bi-heart" :class="isInWishlist(product.id) ? 'text-red-500 fill-current' : 'text-gray-800'"></i>
                                </button>
                            </div>
                            
                            <div class="p-4">
                                <h3 class="font-bold text-lg mb-1">{{ product.name }}</h3>
                                <p class="text-gray-400 text-sm mb-3">{{ product.category }}</p>
                                
                                <div class="flex items-center gap-1 mb-3">
                                    <i v-for="star in 5" :key="star" class="bi text-sm"
                                        :class="star <= product.rating ? 'bi-star-fill text-yellow-400' : 'bi-star text-gray-600'"></i>
                                    <span class="text-gray-400 text-sm mr-2">({{ product.reviews }})</span>
                                </div>
                                
                                <div class="flex items-center justify-between">
                                    <div>
                                        <span v-if="product.discount" class="text-gray-500 line-through text-sm ml-2">
                                            {{ product.originalPrice }} ر.س
                                        </span>
                                        <span class="text-xl font-bold text-purple-400">{{ product.price }} ر.س</span>
                                    </div>
                                    <button @click="addToCart(product)" class="add-btn bg-purple-500 hover:bg-purple-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition-all opacity-0 transform translate-y-2">
                                        <i class="bi bi-cart-plus ml-1"></i>
                                        أضف
                                    </button>
                                </div>
                            </div>
                        </div>
                    </TransitionGroup>
                    
                    <div v-if="filteredProducts.length === 0" class="text-center py-16">
                        <i class="bi bi-search text-6xl text-gray-600 mb-4"></i>
                        <p class="text-gray-400 text-lg">لا توجد منتجات تطابق الفلتر</p>
                        <button @click="resetFilters" class="mt-4 text-purple-400 hover:text-purple-300">
                            إعادة تعيين الفلتر
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <!-- Cart Drawer -->
        <Transition name="cart-drawer">
            <div v-if="cartStore.isCartOpen" class="fixed inset-0 z-50 flex justify-end">
                <div @click="cartStore.closeCart" class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
                
                <div class="relative w-full max-w-md bg-gray-900 h-full overflow-hidden flex flex-col">
                    <div class="p-6 border-b border-gray-800">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-bold">سلة التسوق</h2>
                            <button @click="cartStore.closeCart" class="p-2 hover:bg-gray-800 rounded-lg">
                                <i class="bi bi-x-lg text-xl"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="flex-1 overflow-y-auto p-6">
                        <div v-if="cartStore.items.length === 0" class="text-center py-16">
                            <i class="bi bi-cart-x text-6xl text-gray-600 mb-4"></i>
                            <p class="text-gray-400">السلة فارغة</p>
                        </div>
                        <div v-else class="space-y-4">
                            <div v-for="item in cartStore.items" :key="item.id" class="flex gap-4 bg-gray-800 rounded-xl p-4">
                                <img :src="item.image" :alt="item.name" class="w-20 h-24 object-cover rounded-lg">
                                <div class="flex-1">
                                    <h3 class="font-bold mb-1">{{ item.name }}</h3>
                                    <p class="text-gray-400 text-sm mb-2">{{ item.size }} • {{ item.color }}</p>
                                    <div class="flex items-center justify-between">
                                        <span class="text-purple-400 font-bold">{{ item.price }} ر.س</span>
                                        <div class="flex items-center gap-2">
                                            <button @click="cartStore.decreaseQuantity(item.id)" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded-lg flex items-center justify-center">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <span class="w-8 text-center">{{ item.quantity }}</span>
                                            <button @click="cartStore.increaseQuantity(item.id)" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 rounded-lg flex items-center justify-center">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <button @click="cartStore.removeItem(item.id)" class="text-gray-500 hover:text-red-500 transition-colors">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div v-if="cartStore.items.length > 0" class="p-6 border-t border-gray-800">
                        <div class="flex justify-between mb-4">
                            <span class="text-gray-400">المجموع الفرعي</span>
                            <span class="font-bold">{{ cartStore.subtotal }} ر.س</span>
                        </div>
                        <div class="flex justify-between mb-4">
                            <span class="text-gray-400">الشحن</span>
                            <span class="font-bold text-green-400">مجاني</span>
                        </div>
                        <div class="flex justify-between mb-6 text-lg">
                            <span class="font-bold">الإجمالي</span>
                            <span class="font-bold text-purple-400">{{ cartStore.total }} ر.س</span>
                        </div>
                        <button @click="startCheckout" class="w-full py-3 bg-purple-500 hover:bg-purple-600 rounded-xl font-bold transition-colors">
                            إتمام الشراء
                        </button>
                    </div>
                </div>
            </div>
        </Transition>

        <!-- Quick View Modal -->
        <Transition name="modal">
            <div v-if="quickViewProduct" class="fixed inset-0 z-50 flex items-center justify-center p-4">
                <div @click="closeQuickView" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
                <div class="modal-content relative bg-gray-900 rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                    <button @click="closeQuickView" class="absolute top-4 left-4 w-10 h-10 bg-gray-800 hover:bg-gray-700 rounded-full flex items-center justify-center z-10">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <div class="grid md:grid-cols-2 gap-8 p-8">
                        <div class="aspect-square rounded-xl overflow-hidden">
                            <img :src="quickViewProduct.image" :alt="quickViewProduct.name" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold mb-2">{{ quickViewProduct.name }}</h2>
                            <p class="text-gray-400 mb-4">{{ quickViewProduct.category }}</p>
                            
                            <div class="flex items-center gap-2 mb-4">
                                <div class="flex">
                                    <i v-for="star in 5" :key="star" class="bi"
                                        :class="star <= quickViewProduct.rating ? 'bi-star-fill text-yellow-400' : 'bi-star text-gray-600'"></i>
                                </div>
                                <span class="text-gray-400">({{ quickViewProduct.reviews }} تقييم)</span>
                            </div>
                            
                            <p class="text-gray-300 mb-6 leading-relaxed">{{ quickViewProduct.description }}</p>
                            
                            <div class="mb-6">
                                <span v-if="quickViewProduct.discount" class="text-gray-500 line-through text-lg ml-2">
                                    {{ quickViewProduct.originalPrice }} ر.س
                                </span>
                                <span class="text-3xl font-bold text-purple-400">{{ quickViewProduct.price }} ر.س</span>
                            </div>
                            
                            <div class="mb-6">
                                <label class="text-sm text-gray-400 mb-2 block">المقاس</label>
                                <div class="flex gap-2">
                                    <button v-for="size in quickViewProduct.sizes" :key="size"
                                        :class="selectedSize === size ? 'bg-purple-500 text-white' : 'bg-gray-800 text-gray-300 hover:bg-gray-700'"
                                        @click="selectedSize = size"
                                        class="px-4 py-2 rounded-lg font-medium transition-colors">
                                        {{ size }}
                                    </button>
                                </div>
                            </div>
                            
                            <div class="mb-6">
                                <label class="text-sm text-gray-400 mb-2 block">اللون</label>
                                <div class="flex gap-2">
                                    <button v-for="color in quickViewProduct.colors" :key="color.id"
                                        :class="selectedColor === color.id ? 'ring-2 ring-purple-500 ring-offset-2 ring-offset-gray-900' : ''"
                                        @click="selectedColor = color.id"
                                        class="w-10 h-10 rounded-full transition-transform hover:scale-110"
                                        :style="{ backgroundColor: color.hex }"
                                        :title="color.name">
                                    </button>
                                </div>
                            </div>
                            
                            <button @click="addToCartFromQuickView" class="w-full py-3 bg-purple-500 hover:bg-purple-600 rounded-xl font-bold transition-colors">
                                <i class="bi bi-cart-plus ml-2"></i>
                                أضف للسلة
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </Transition>

        <!-- Checkout Modal -->
        <Transition name="modal">
            <div v-if="showCheckout" class="fixed inset-0 z-[100] flex items-center justify-center p-4">
                <div @click="closeCheckoutModal" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
                <div class="modal-content relative bg-gray-900 rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
                    <button @click="closeCheckoutModal" class="absolute top-4 left-4 w-10 h-10 bg-gray-800 hover:bg-gray-700 rounded-full flex items-center justify-center z-10">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <div class="p-8">
                        <h2 class="text-2xl font-bold mb-8">إتمام الشراء</h2>
                        
                        <div class="flex items-center justify-between mb-8">
                            <div v-for="(step, index) in checkoutSteps" :key="index" class="flex items-center">
                                <div class="flex flex-col items-center">
                                    <div :class="checkoutStep > index ? 'bg-green-500' : (checkoutStep === index ? 'bg-purple-500' : 'bg-gray-700')"
                                        class="w-10 h-10 rounded-full flex items-center justify-center font-bold mb-2">
                                        <i v-if="checkoutStep > index" class="bi bi-check"></i>
                                        <span v-else>{{ index + 1 }}</span>
                                    </div>
                                    <span class="text-sm text-gray-400">{{ step }}</span>
                                </div>
                                <div v-if="index < checkoutSteps.length - 1"
                                    :class="checkoutStep > index ? 'bg-green-500' : 'bg-gray-700'"
                                    class="w-20 h-1 mx-2">
                                </div>
                            </div>
                        </div>
                        
                        <div v-if="checkoutStep === 0" class="space-y-4">
                            <div>
                                <label class="text-sm text-gray-400 mb-2 block">الاسم الكامل</label>
                                <input type="text" v-model="shippingInfo.name" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-sm text-gray-400 mb-2 block">رقم الهاتف</label>
                                <input type="tel" v-model="shippingInfo.phone" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="text-sm text-gray-400 mb-2 block">العنوان</label>
                                <textarea v-model="shippingInfo.address" rows="3" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none"></textarea>
                            </div>
                        </div>
                        
                        <div v-if="checkoutStep === 1" class="space-y-4">
                            <div>
                                <label class="text-sm text-gray-400 mb-2 block">رقم البطاقة</label>
                                <input type="text" v-model="paymentInfo.cardNumber" placeholder="1234 5678 9012 3456" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none">
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="text-sm text-gray-400 mb-2 block">تاريخ الانتهاء</label>
                                    <input type="text" v-model="paymentInfo.expiry" placeholder="MM/YY" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none">
                                </div>
                                <div>
                                    <label class="text-sm text-gray-400 mb-2 block">CVV</label>
                                    <input type="text" v-model="paymentInfo.cvv" placeholder="123" class="w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 focus:border-purple-500 focus:outline-none">
                                </div>
                            </div>
                        </div>
                        
                        <div v-if="checkoutStep === 2" class="text-center py-8">
                            <div class="w-20 h-20 bg-green-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="bi bi-check-lg text-4xl text-green-500"></i>
                            </div>
                            <h3 class="text-2xl font-bold mb-2">تم الطلب بنجاح!</h3>
                            <p class="text-gray-400 mb-6">رقم الطلب: #{{ orderId }}</p>
                            <p class="text-gray-300 mb-6">شكراً لتسوقك معنا. سيتم شحن طلبك خلال 2-3 أيام عمل.</p>
                            <button @click="closeCheckoutModal" class="px-8 py-3 bg-purple-500 hover:bg-purple-600 rounded-xl font-bold transition-colors">
                                العودة للمتجر
                            </button>
                        </div>
                        
                        <div v-if="checkoutStep < 2" class="flex gap-4 mt-8">
                            <button v-if="checkoutStep > 0" @click="checkoutStep--" class="flex-1 py-3 bg-gray-800 hover:bg-gray-700 rounded-xl font-bold transition-colors">
                                السابق
                            </button>
                            <button @click="nextCheckoutStep" class="flex-1 py-3 bg-purple-500 hover:bg-purple-600 rounded-xl font-bold transition-colors">
                                {{ checkoutStep === 1 ? 'إتمام الطلب' : 'التالي' }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </Transition>
    </div>

    <script>
        const { createApp, ref, computed, reactive } = Vue;
        const { createPinia, defineStore } = Pinia;

        const useCartStore = defineStore('cart', {
            state: () => ({
                items: [],
                isCartOpen: false
            }),
            getters: {
                totalItems: (state) => state.items.reduce((sum, item) => sum + item.quantity, 0),
                subtotal: (state) => state.items.reduce((sum, item) => sum + (item.price * item.quantity), 0),
                total: (state) => state.items.reduce((sum, item) => sum + (item.price * item.quantity), 0)
            },
            actions: {
                addItem(product, size, color) {
                    const existing = this.items.find(item => 
                        item.id === product.id && item.size === size && item.color === color
                    );
                    if (existing) {
                        existing.quantity++;
                    } else {
                        this.items.push({
                            ...product,
                            quantity: 1,
                            size,
                            color
                        });
                    }
                },
                removeItem(id) {
                    this.items = this.items.filter(item => item.id !== id);
                },
                increaseQuantity(id) {
                    const item = this.items.find(item => item.id === id);
                    if (item) item.quantity++;
                },
                decreaseQuantity(id) {
                    const item = this.items.find(item => item.id === id);
                    if (item && item.quantity > 1) {
                        item.quantity--;
                    } else {
                        this.removeItem(id);
                    }
                },
                openCart() { this.isCartOpen = true; },
                closeCart() { this.isCartOpen = false; },
                clear() { this.items = []; }
            }
        });

        const products = [
            {
                id: 1,
                name: "قميص كلاسيكي",
                category: "قمصان",
                price: 199,
                originalPrice: 249,
                discount: 20,
                rating: 4.5,
                reviews: 128,
                isNew: true,
                image: "https://picsum.photos/400/500?random=1",
                sizes: ["S", "M", "L", "XL"],
                colors: [{ id: 1, name: "أبيض", hex: "#ffffff" }, { id: 2, name: "أزرق", hex: "#3b82f6" }],
                description: "قميص كلاسيكي أنيق مصنوع من القطن عالي الجودة. مثالي للمناسبات الرسمية واليومية."
            },
            {
                id: 2,
                name: "بنطال جينز",
                category: "بنطلونات",
                price: 249,
                originalPrice: null,
                discount: null,
                rating: 4.8,
                reviews: 256,
                isNew: false,
                image: "https://picsum.photos/400/500?random=2",
                sizes: ["28", "30", "32", "34"],
                colors: [{ id: 3, name: "أزرق داكن", hex: "#1e3a5f" }, { id: 4, name: "أسود", hex: "#000000" }],
                description: "بنطال جينز مريح بتصميم عصري. مثالي للاستخدام اليومي."
            },
            {
                id: 3,
                name: "فستان صيفي",
                category: "فساتين",
                price: 349,
                originalPrice: 449,
                discount: 22,
                rating: 4.7,
                reviews: 89,
                isNew: true,
                image: "https://picsum.photos/400/500?random=3",
                sizes: ["S", "M", "L"],
                colors: [{ id: 5, name: "وردي", hex: "#ec4899" }, { id: 6, name: "أصفر", hex: "#fbbf24" }],
                description: "فستان صيفي خفيف وأنيق. مثالي للمناسبات الصيفية والخروجات."
            },
            {
                id: 4,
                name: "جاكيت رياضي",
                category: "جاكيتات",
                price: 399,
                originalPrice: null,
                discount: null,
                rating: 4.6,
                reviews: 167,
                isNew: false,
                image: "https://picsum.photos/400/500?random=4",
                sizes: ["M", "L", "XL", "XXL"],
                colors: [{ id: 7, name: "رمادي", hex: "#6b7280" }, { id: 8, name: "أسود", hex: "#000000" }],
                description: "جاكيت رياضي مريح وعصري. مثالي للتمارين والاستخدام اليومي."
            },
            {
                id: 5,
                name: "حذاء رياضي",
                category: "أحذية",
                price: 299,
                originalPrice: 399,
                discount: 25,
                rating: 4.9,
                reviews: 312,
                isNew: true,
                image: "https://picsum.photos/400/500?random=5",
                sizes: ["40", "41", "42", "43", "44"],
                colors: [{ id: 9, name: "أبيض", hex: "#ffffff" }, { id: 10, name: "أسود", hex: "#000000" }],
                description: "حذاء رياضي مريح بتصميم عصري. مثالي للجري والمشي."
            },
            {
                id: 6,
                name: "تيشيرت قطني",
                category: "تيشيرتات",
                price: 149,
                originalPrice: null,
                discount: null,
                rating: 4.4,
                reviews: 198,
                isNew: false,
                image: "https://picsum.photos/400/500?random=6",
                sizes: ["S", "M", "L", "XL"],
                colors: [{ id: 11, name: "أخضر", hex: "#22c55e" }, { id: 12, name: "أحمر", hex: "#ef4444" }],
                description: "تيشيرت قطني مريح وخفيف. مثالي للاستخدام اليومي."
            },
            {
                id: 7,
                name: "ساعة كلاسيكية",
                category: "إكسسوارات",
                price: 499,
                originalPrice: 649,
                discount: 23,
                rating: 4.8,
                reviews: 145,
                isNew: false,
                image: "https://picsum.photos/400/500?random=7",
                sizes: ["واحد"],
                colors: [{ id: 13, name: "ذهبي", hex: "#fbbf24" }, { id: 14, name: "فضي", hex: "#9ca3af" }],
                description: "ساعة كلاسيكية أنيقة بتصميم عصري. مثالية للمناسبات الرسمية."
            },
            {
                id: 8,
                name: "حقيبة جلدية",
                category: "حقائب",
                price: 449,
                originalPrice: null,
                discount: null,
                rating: 4.7,
                reviews: 87,
                isNew: true,
                image: "https://picsum.photos/400/500?random=8",
                sizes: ["واحد"],
                colors: [{ id: 15, name: "بني", hex: "#92400e" }, { id: 16, name: "أسود", hex: "#000000" }],
                description: "حقيبة جلدية أنيقة ومتينة. مثالية للعمل والسفر."
            },
            {
                id: 9,
                name: "نظارة شمسية",
                category: "إكسسوارات",
                price: 199,
                originalPrice: 249,
                discount: 20,
                rating: 4.5,
                reviews: 234,
                isNew: false,
                image: "https://picsum.photos/400/500?random=9",
                sizes: ["واحد"],
                colors: [{ id: 17, name: "أسود", hex: "#000000" }, { id: 18, name: "بني", hex: "#92400e" }],
                description: "نظارة شمسية أنيقة بحماية UV. مثالية للخروجات الصيفية."
            },
            {
                id: 10,
                name: "سترة صوفية",
                category: "سترات",
                price: 279,
                originalPrice: null,
                discount: null,
                rating: 4.6,
                reviews: 156,
                isNew: false,
                image: "https://picsum.photos/400/500?random=10",
                sizes: ["S", "M", "L", "XL"],
                colors: [{ id: 19, name: "بيج", hex: "#d4a574" }, { id: 20, name: "رمادي", hex: "#6b7280" }],
                description: "سترة صوفية دافئة ومريحة. مثالية للأيام الباردة."
            },
            {
                id: 11,
                name: "قميص منقوش",
                category: "قمصان",
                price: 229,
                originalPrice: 279,
                discount: 18,
                rating: 4.4,
                reviews: 98,
                isNew: true,
                image: "https://picsum.photos/400/500?random=11",
                sizes: ["S", "M", "L", "XL"],
                colors: [{ id: 21, name: "أزرق", hex: "#3b82f6" }, { id: 22, name: "أخضر", hex: "#22c55e" }],
                description: "قميص منقوش أنيق بتصميم عصري. مثالي للمناسبات الرسمية."
            },
            {
                id: 12,
                name: "شورت رياضي",
                category: "شورتات",
                price: 179,
                originalPrice: null,
                discount: null,
                rating: 4.3,
                reviews: 145,
                isNew: false,
                image: "https://picsum.photos/400/500?random=12",
                sizes: ["S", "M", "L", "XL"],
                colors: [{ id: 23, name: "أسود", hex: "#000000" }, { id: 24, name: "رمادي", hex: "#6b7280" }],
                description: "شورت رياضي مريح وخفيف. مثالي للتمارين والاستخدام اليومي."
            }
        ];

        const colors = [
            { id: 1, name: "أبيض", hex: "#ffffff" },
            { id: 2, name: "أزرق", hex: "#3b82f6" },
            { id: 3, name: "أخضر", hex: "#22c55e" },
            { id: 4, name: "أحمر", hex: "#ef4444" },
            { id: 5, name: "أسود", hex: "#000000" },
            { id: 6, name: "رمادي", hex: "#6b7280" },
            { id: 7, name: "وردي", hex: "#ec4899" },
            { id: 8, name: "أصفر", hex: "#fbbf24" }
        ];

        const sizes = ["S", "M", "L", "XL", "XXL"];

        createApp({
            setup() {
                const pinia = createPinia();
                const cartStore = useCartStore();
                
                const filters = reactive({
                    maxPrice: 500,
                    colors: [],
                    sizes: [],
                    rating: 0
                });
                
                const sortBy = ref('default');
                const showMobileFilters = ref(false);
                const quickViewProduct = ref(null);
                const selectedSize = ref(null);
                const selectedColor = ref(null);
                const showCheckout = ref(false);
                const checkoutStep = ref(0);
                const checkoutSteps = ['الشحن', 'الدفع', 'التأكيد'];
                const orderId = ref('');
                const wishlist = ref([]);
                
                const shippingInfo = reactive({
                    name: '',
                    phone: '',
                    address: ''
                });
                
                const paymentInfo = reactive({
                    cardNumber: '',
                    expiry: '',
                    cvv: ''
                });
                
                const hasActiveFilters = computed(() => {
                    return filters.colors.length > 0 || 
                           filters.sizes.length > 0 || 
                           filters.rating > 0 ||
                           filters.maxPrice < 500;
                });
                
                const filteredProducts = computed(() => {
                    let result = [...products];
                    
                    result = result.filter(p => p.price <= filters.maxPrice);
                    
                    if (filters.rating > 0) {
                        result = result.filter(p => p.rating >= filters.rating);
                    }
                    
                    if (sortBy.value === 'price-asc') {
                        result.sort((a, b) => a.price - b.price);
                    } else if (sortBy.value === 'price-desc') {
                        result.sort((a, b) => b.price - a.price);
                    } else if (sortBy.value === 'rating') {
                        result.sort((a, b) => b.rating - a.rating);
                    }
                    
                    return result;
                });
                
                const wishlistCount = computed(() => wishlist.value.length);
                
                const toggleColor = (id) => {
                    const idx = filters.colors.indexOf(id);
                    if (idx > -1) {
                        filters.colors.splice(idx, 1);
                    } else {
                        filters.colors.push(id);
                    }
                };
                
                const toggleSize = (size) => {
                    const idx = filters.sizes.indexOf(size);
                    if (idx > -1) {
                        filters.sizes.splice(idx, 1);
                    } else {
                        filters.sizes.push(size);
                    }
                };
                
                const resetFilters = () => {
                    filters.maxPrice = 500;
                    filters.colors = [];
                    filters.sizes = [];
                    filters.rating = 0;
                };
                
                const openQuickView = (product) => {
                    quickViewProduct.value = product;
                    selectedSize.value = product.sizes[0];
                    selectedColor.value = product.colors[0].id;
                };
                
                const closeQuickView = () => {
                    quickViewProduct.value = null;
                };
                
                const addToCart = (product) => {
                    const size = product.sizes[0];
                    const color = product.colors[0].name;
                    cartStore.addItem(product, size, color);
                };
                
                const addToCartFromQuickView = () => {
                    if (!quickViewProduct.value) return;
                    const colorName = quickViewProduct.value.colors.find(c => c.id === selectedColor.value)?.name || '';
                    cartStore.addItem(quickViewProduct.value, selectedSize.value, colorName);
                    closeQuickView();
                };
                
                const closeCheckoutModal = () => {
                    showCheckout.value = false;
                    checkoutStep.value = 0;
                };

                const startCheckout = () => {
                    cartStore.closeCart();
                    showCheckout.value = true;
                    checkoutStep.value = 0;
                    orderId.value = Math.random().toString(36).substr(2, 9).toUpperCase();
                };
                
                const nextCheckoutStep = () => {
                    if (checkoutStep.value < 2) {
                        checkoutStep.value++;
                    }
                };
                
                const toggleWishlist = () => {
                };
                
                const toggleWishlistItem = (id) => {
                    const idx = wishlist.value.indexOf(id);
                    if (idx > -1) {
                        wishlist.value.splice(idx, 1);
                    } else {
                        wishlist.value.push(id);
                    }
                };
                
                const isInWishlist = (id) => {
                    return wishlist.value.includes(id);
                };
                
                return {
                    cartStore,
                    filters,
                    sortBy,
                    showMobileFilters,
                    quickViewProduct,
                    selectedSize,
                    selectedColor,
                    showCheckout,
                    checkoutStep,
                    checkoutSteps,
                    orderId,
                    shippingInfo,
                    paymentInfo,
                    wishlist,
                    colors,
                    sizes,
                    hasActiveFilters,
                    filteredProducts,
                    wishlistCount,
                    toggleColor,
                    toggleSize,
                    resetFilters,
                    openQuickView,
                    closeQuickView,
                    addToCart,
                    addToCartFromQuickView,
                    startCheckout,
                    closeCheckoutModal,
                    nextCheckoutStep,
                    toggleWishlist,
                    toggleWishlistItem,
                    isInWishlist
                };
            }
        }).use(createPinia()).mount('#app');
    </script>
</body>
</html>